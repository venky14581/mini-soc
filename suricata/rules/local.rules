# ==============================================================================
# Mini-SOC Custom Suricata Detection Rules
# Mapped to MITRE ATT&CK Framework
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Reconnaissance & Discovery: Port Scans (MITRE T1046: Network Service Scanning)
# ------------------------------------------------------------------------------

# Detect Nmap TCP SYN Stealth Scan
alert tcp any any -> $HOME_NET any (msg:"MINI-SOC - Nmap TCP SYN Scan Detected"; flags:S; window:1024; threshold:type both, track by_src, count 5, seconds 10; classtype:attempted-recon; sid:1000001; rev:1; metadata:mitre_technique_id T1046, mitre_technique_name Network_Service_Scanning, mitre_tactic_id TA0007, mitre_tactic_name Discovery, severity high;)

# Detect Nmap TCP NULL Scan (No flags set)
alert tcp any any -> $HOME_NET any (msg:"MINI-SOC - Nmap TCP NULL Scan Detected"; flags:0,12; classtype:attempted-recon; sid:1000002; rev:1; metadata:mitre_technique_id T1046, mitre_technique_name Network_Service_Scanning, mitre_tactic_id TA0007, mitre_tactic_name Discovery, severity high;)

# Detect Nmap TCP XMAS Scan (FIN, PSH, URG set)
alert tcp any any -> $HOME_NET any (msg:"MINI-SOC - Nmap TCP XMAS Scan Detected"; flags:FPU,12; classtype:attempted-recon; sid:1000003; rev:1; metadata:mitre_technique_id T1046, mitre_technique_name Network_Service_Scanning, mitre_tactic_id TA0007, mitre_tactic_name Discovery, severity high;)

# Detect Nmap TCP FIN Scan (FIN set without ACK)
alert tcp any any -> $HOME_NET any (msg:"MINI-SOC - Nmap TCP FIN Scan Detected"; flags:F,12; classtype:attempted-recon; sid:1000004; rev:1; metadata:mitre_technique_id T1046, mitre_technique_name Network_Service_Scanning, mitre_tactic_id TA0007, mitre_tactic_name Discovery, severity high;)

# Detect Rapid Horizontal / Multi-Port Scan (Threshold rule)
alert tcp any any -> $HOME_NET any (msg:"MINI-SOC - Rapid Port Scan Threshold Exceeded"; flags:S; threshold:type both, track by_src, count 10, seconds 5; classtype:attempted-recon; sid:1000005; rev:1; metadata:mitre_technique_id T1046, mitre_technique_name Network_Service_Scanning, mitre_tactic_id TA0007, mitre_tactic_name Discovery, severity high;)


# ------------------------------------------------------------------------------
# 2. Credential Access: SSH Brute-Force (MITRE T1110.001: Password Guessing)
# ------------------------------------------------------------------------------

# Detect SSH Brute-Force Authentication Attempt (>= 5 connection attempts in 60s)
alert tcp any any -> $HOME_NET 22 (msg:"MINI-SOC - Possible SSH Brute-Force Attempt Detected"; flow:to_server; threshold:type both, track by_src, count 5, seconds 60; classtype:attempted-admin; sid:1000010; rev:2; metadata:mitre_technique_id T1110.001, mitre_technique_name Password_Guessing, mitre_tactic_id TA0006, mitre_tactic_name Credential_Access, severity critical;)

# Detect Hydra / Medusa SSH Client Banner or High-Rate Handshake
alert ssh any any -> $HOME_NET 22 (msg:"MINI-SOC - Automated SSH Login Tool Fingerprint"; flow:to_server,established; threshold:type both, track by_src, count 3, seconds 30; classtype:attempted-admin; sid:1000011; rev:1; metadata:mitre_technique_id T1110.001, mitre_technique_name Password_Guessing, mitre_tactic_id TA0006, mitre_tactic_name Credential_Access, severity critical;)


# ------------------------------------------------------------------------------
# 3. Initial Access / Exploitation: Web Attacks (MITRE T1190: Exploit Public-Facing App)
# ------------------------------------------------------------------------------

# Detect SQL Injection - UNION SELECT Pattern
alert http any any -> $HOME_NET any (msg:"MINI-SOC - SQL Injection Attempt (UNION SELECT)"; flow:to_server,established; content:"UNION"; nocase; http_uri; content:"SELECT"; nocase; http_uri; classtype:web-application-attack; sid:1000020; rev:1; metadata:mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, severity high;)

# Detect SQL Injection - Classic Boolean Bypass (' OR '1'='1)
alert http any any -> $HOME_NET any (msg:"MINI-SOC - SQL Injection Attempt (Boolean Bypass)"; flow:to_server,established; content:"' or "; nocase; http_uri; classtype:web-application-attack; sid:1000021; rev:1; metadata:mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, severity high;)

# Detect Path Traversal / Arbitrary File Read (../ /etc/passwd or win.ini)
alert http any any -> $HOME_NET any (msg:"MINI-SOC - Directory Traversal Attempt (/etc/passwd)"; flow:to_server,established; content:"../"; http_uri; content:"etc/passwd"; nocase; http_uri; classtype:web-application-attack; sid:1000022; rev:1; metadata:mitre_technique_id T1083, mitre_technique_name File_and_Directory_Discovery, mitre_tactic_id TA0007, mitre_tactic_name Discovery, severity high;)

# Detect Generic Path Traversal Sequence
alert http any any -> $HOME_NET any (msg:"MINI-SOC - Directory Traversal Sequence Detected"; flow:to_server,established; content:"../../"; http_uri; classtype:web-application-attack; sid:1000023; rev:1; metadata:mitre_technique_id T1083, mitre_technique_name File_and_Directory_Discovery, mitre_tactic_id TA0007, mitre_tactic_name Discovery, severity medium;)


# ------------------------------------------------------------------------------
# 4. Command and Scripting Interpreter (MITRE T1059: Command and Scripting Interpreter)
# ------------------------------------------------------------------------------

# Detect Web Shell / Remote Command Execution via URI or Body
alert http any any -> $HOME_NET any (msg:"MINI-SOC - Web Shell Command Injection (/bin/sh or bash)"; flow:to_server,established; content:"/bin/sh"; nocase; http_uri; classtype:attempted-admin; sid:1000030; rev:1; metadata:mitre_technique_id T1059, mitre_technique_name Command_and_Scripting_Interpreter, mitre_tactic_id TA0002, mitre_tactic_name Execution, severity critical;)

# Detect Log4j JNDI Exploit Probe
alert http any any -> $HOME_NET any (msg:"MINI-SOC - Log4j JNDI RCE Exploit Probe"; flow:to_server; content:"${jndi:"; nocase; classtype:attempted-admin; sid:1000031; rev:1; metadata:mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, severity critical;)


# ------------------------------------------------------------------------------
# 5. Reconnaissance: Malicious & Automated User-Agents (MITRE T1595.002: Vulnerability Scanning)
# ------------------------------------------------------------------------------

# Detect Nikto Web Vulnerability Scanner User Agent
alert http any any -> $HOME_NET any (msg:"MINI-SOC - Nikto Web Scanner Activity Detected"; flow:to_server; content:"Nikto"; nocase; http_user_agent; classtype:attempted-recon; sid:1000040; rev:1; metadata:mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, severity medium;)

# Detect sqlmap Automated SQLi Tool User Agent
alert http any any -> $HOME_NET any (msg:"MINI-SOC - sqlmap Automated Injection Tool Detected"; flow:to_server; content:"sqlmap"; nocase; http_user_agent; classtype:web-application-attack; sid:1000041; rev:1; metadata:mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, severity high;)

# Detect Gobuster / Directory Enumeration User Agent
alert http any any -> $HOME_NET any (msg:"MINI-SOC - Gobuster Web Directory Enumeration Detected"; flow:to_server; content:"gobuster"; nocase; http_user_agent; classtype:attempted-recon; sid:1000042; rev:1; metadata:mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, severity medium;)


# ------------------------------------------------------------------------------
# 6. Benign / Internal Vulnerability Scanner Activity (MITRE T1595: Active Scanning)
# Used for testing auto-tagging, noise reduction, and suppression playbooks
# ------------------------------------------------------------------------------

# Detect Authorized Internal Security Audit Scanner
alert http any any -> $HOME_NET any (msg:"MINI-SOC - Authorized Internal Security Scanner Probe"; flow:to_server; content:"MiniSOC-AuditScanner/1.0"; http_user_agent; classtype:attempted-recon; sid:1000050; rev:1; metadata:mitre_technique_id T1595, mitre_technique_name Active_Scanning, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, benign_authorized true, severity info;)
