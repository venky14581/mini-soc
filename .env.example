# ==============================================================================
# Mini-SOC Enterprise Environment Configuration
# Copy this file to .env and populate production values
# ==============================================================================

# Core Service Configuration
ENVIRONMENT=production
PORT_SIEM=8000
PORT_SOAR=8001
SOAR_URL=http://localhost:8001/soar/webhook
SOAR_API_BASE=http://localhost:8001/soar
SOAR_DB_PATH=soar_actions.db
FIREWALL_MODE=auto

# Security & Mutual Webhook Authentication Secrets
SOAR_SHARED_SECRET=replace-with-cryptographic-random-64char-secret
SOAR_ANALYST_TOKEN=replace-with-analyst-session-jwt-secret
MINI_SOC_INGEST_API_KEY=replace-with-log-shipper-bearer-token

# ChatOps & Alerting Integrations (Slack / Microsoft Teams)
SOAR_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR_WORKSPACE/YOUR_CHANNEL/YOUR_WEBHOOK_TOKEN
PAGERDUTY_ROUTING_KEY=pd-secops-escalation-key-123456

# Ticketing & Issue Tracking Integration (Jira / GitHub)
SOAR_JIRA_URL=https://yourcompany.atlassian.net
SOAR_JIRA_USER=secops-bot@yourcompany.com
SOAR_JIRA_API_TOKEN=jira-api-token-xxxxxxxxxxxx
SOAR_JIRA_PROJECT=SECOPS

# Cloud Perimeter WAF Integration (AWS WAF & Cloudflare)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_WAF_IPSET_ID=ipset-id-123456-prod-blacklist
CLOUDFLARE_API_TOKEN=cf-token-xxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_ZONE_ID=zone-id-xxxxxxxxxxxxxxxxxxxx

# Identity & Access Management (Okta / Auth0)
OKTA_ORG_URL=https://yourcompany.okta.com
OKTA_API_TOKEN=okta-api-token-xxxxxxxxxxxxxxxx

# Threat Intelligence Feed API Keys (Optional external sync)
ABUSEIPDB_API_KEY=abuseipdb-api-key-xxxxxxxxxxxx
OTX_API_KEY=alienvault-otx-api-key-xxxxxxxxxxxx
